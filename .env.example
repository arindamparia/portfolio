# Neon Database Configuration
# Copy this file to .env and fill in your actual database connection string
DATABASE_URL=postgresql://your_user:your_password@your-host.neon.tech/your_database?sslmode=require&channel_binding=require

# Allowed CORS Origins (comma-separated)
#
# Development: Include localhost ports (required for local testing with Express server)
# Production: Only needed if you want to allow OTHER DOMAINS to call your API
#
# NOTE: In production, your site makes same-origin requests (yoursite.com → yoursite.com/api),
# so CORS doesn't apply. Only add production domains here if you want to allow cross-origin
# API calls from other websites you control.
#
# Examples:
# - Development only: http://localhost:5173,http://localhost:3000
# - With partner site: http://localhost:5173,http://localhost:3000,https://partner-site.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# TraceMyDSA - DSA Tracking Tool URL
VITE_DSA_TRACKER_URL=https://tracemydsa.netlify.app

# Privacy Consent Banner Switch
# Set to 'true' to display the privacy consent popup; disabled ('false') by default
VITE_ENABLE_CONSENT_POPUP=false

